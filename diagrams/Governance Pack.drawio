<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="governance" name="Governance pack"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Governance pack: Marketing Automation with AI &amp; Agents" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#24292f;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1170" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Business goals" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a7f37;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="260" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Architecture principles" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f6feb;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="380" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Architecture decisions (ADRs)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#8250df;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="390" height="24" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;G2&lt;/b&gt; Customer trust &amp; PDPL compliance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="260" height="58" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;P1. Privacy by design (PDPL)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Minimise, consent-gate, keep in-region; no raw PII to 3rd-party models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="380" height="58" as="geometry"/></mxCell><mxCell id="c8" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;G5&lt;/b&gt; Brand safety" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="154" width="260" height="58" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;P2. Agents propose, humans approve&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Generated content ships only via approval queue or approved templates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="154" width="380" height="58" as="geometry"/></mxCell><mxCell id="c11" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;G3&lt;/b&gt; Lower cost per conversion" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="228" width="260" height="58" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;P3. Precompute by default&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Batch unless real-time changes the outcome; real-time needs a latency budget&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="228" width="380" height="58" as="geometry"/></mxCell><mxCell id="c14" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;G1&lt;/b&gt; Repeat revenue / conversion uplift" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="302" width="260" height="58" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;P4. No eval, no launch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Offline eval + online KPI + kill switch for every model and agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="302" width="380" height="58" as="geometry"/></mxCell><mxCell id="c17" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;G4&lt;/b&gt; Checkout always available" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="376" width="260" height="58" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;P5. Protect the transactional core&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;No AI/analytics reads on the operational DB (CDC only); safe fallbacks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="376" width="380" height="58" as="geometry"/></mxCell><mxCell id="c20" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;ADR-001 LLM hosting&lt;/b&gt;&lt;br&gt;Managed API (in-region) behind a PII-redacting LLM gateway; copy per segment; human approval queue&lt;br&gt;&lt;font color='#8250df'&gt;&lt;b&gt;Applies: P1 P2 P3 P4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fbefff;strokeColor=#8250df;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="390" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ADR-002 Vector DB&lt;/b&gt;&lt;br&gt;pgvector on a dedicated Postgres (not the operational DB); swap to Qdrant at &gt;10M vectors&lt;br&gt;&lt;font color='#8250df'&gt;&lt;b&gt;Applies: P3 P5 P1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fbefff;strokeColor=#8250df;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="202" width="390" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;ADR-003 Real-time vs batch&lt;/b&gt;&lt;br&gt;Hybrid: Airflow batch by default; Flink only for event-triggered journeys + session features&lt;br&gt;&lt;font color='#8250df'&gt;&lt;b&gt;Applies: P3 P5&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fbefff;strokeColor=#8250df;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="324" width="390" height="100" as="geometry"/></mxCell><mxCell id="c24" value="constrain" style="html=1;endArrow=block;endFill=1;strokeColor=#8250df;strokeWidth=1.5;fontColor=#8250df;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="260" as="sourcePoint"/><mxPoint x="795" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Design review flow (every new or changed design)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#bc4c00;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="700" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;1. Design PR&lt;/b&gt;&lt;br&gt;design manifest&lt;br&gt;(designs/*.yaml)&lt;br&gt;+ ADR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f6f8fa;strokeColor=#57606a;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;2. CI guardrail&lt;/b&gt; ⚙&lt;br&gt;tools/arb_guardrail.py&lt;br&gt;ADR lint + rules R1–R8" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="190" height="90" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff1e5;strokeColor=#bc4c00;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="505" width="300" height="205" as="geometry"/></mxCell><mxCell id="c29" value="3. ARB checklist (human review)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#bc4c00;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="508" width="280" height="22" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Security&lt;/b&gt;: authZ, secrets, prompt injection, agent least privilege" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="534" width="276" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Privacy (PDPL)&lt;/b&gt;: consent, residency, retention, DSR, DPIA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="562" width="276" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Evals&lt;/b&gt;: AR/EN golden set, LLM-judge, A/B + guardrail metric" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="590" width="276" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Cost&lt;/b&gt;: per-1k cost at avg and 6× peak, token budgets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="618" width="276" height="24" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Human oversight&lt;/b&gt;: owner, approval queue, caps, kill switch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="646" width="276" height="24" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Resilience&lt;/b&gt;: timeouts, fallbacks, no op-DB reads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="492" y="674" width="276" height="24" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;4. Decision&lt;/b&gt;&lt;br&gt;Approve&lt;br&gt;Approve w/ conditions&lt;br&gt;Reject" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#bc4c00;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;5. Merge&lt;/b&gt;&lt;br&gt;ADR → Accepted&lt;br&gt;design goes live" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="150" height="90" as="geometry"/></mxCell><mxCell id="c38" value="open PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#57606a;strokeWidth=1.5;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="fail: names rule + principle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="680"/><mxPoint x="105" y="680"/></Array></mxGeometry></mxCell><mxCell id="c43" value="conditions / reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.2;entryY=1;" edge="1" parent="1" source="c36" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="735"/><mxPoint x="54" y="735"/></Array></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Revisit loop:&lt;/b&gt; each ADR lists revisit triggers (e.g. &amp;gt;5M generations/month, &amp;gt;10M vectors, online P95 &amp;gt; 50 ms, &amp;gt;5 sub-minute use cases). Hitting one re-opens the ADR as a new design PR. ⚙ = automated check." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f6f8fa;strokeColor=#57606a;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1170" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>