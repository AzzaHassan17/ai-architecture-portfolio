l><mxCell id="c24" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1419.0" y="116" as="sourcePoint"/><mxPoint x="1419.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Feature store /&lt;br&gt;Vector DB (not used)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f6f8fa;strokeColor=#57606a;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1494" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1553.0" y="116" as="sourcePoint"/><mxPoint x="1553.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dafbe1;strokeColor=#1a7f37;align=center;verticalAlign=middle;spacing=6;opacity=35;" vertex="1" parent="1"><mxGeometry x="10" y="130" width="1612" height="200" as="geometry"/></mxCell><mxCell id="c28" value="Background: streaming ingestion (seconds)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a7f37;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="900" height="20" as="geometry"/></mxCell><mxCell id="c29" value="1. POST /cart/items" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="79.0" y="170" as="sourcePoint"/><mxPoint x="213.0" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="2. route" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.0" y="170" as="sourcePoint"/><mxPoint x="347.0" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="3. write cart row" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.0" y="200" as="sourcePoint"/><mxPoint x="481.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="4. WAL / binlog" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="481.0" y="230" as="sourcePoint"/><mxPoint x="615.0" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="5. cart.updated" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615.0" y="260" as="sourcePoint"/><mxPoint x="749.0" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffebe9;strokeColor=#cf222e;align=center;verticalAlign=middle;spacing=6;opacity=35;" vertex="1" parent="1"><mxGeometry x="10" y="345" width="1612" height="260" as="geometry"/></mxCell><mxCell id="c35" value="Batch trigger path (every 15 min)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#cf222e;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="347" width="900" height="20" as="geometry"/></mxCell><mxCell id="c36" value="6. cart + order events land in lake  [5-15 min lag]" style="html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="749.0" y="385" as="sourcePoint"/><mxPoint x="1419.0" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="7. carts idle &gt; 60 min&lt;br&gt;and no order (as of lag)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#cf222e;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1353.0" y="407" width="132" height="36" as="geometry"/></mxCell><mxCell id="c38" value="8. audience list + FBT" style="html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1419.0" y="465" as="sourcePoint"/><mxPoint x="1285.0" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="9. trigger campaign batch" style="html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1419.0" y="505" as="sourcePoint"/><mxPoint x="1017.0" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="10. burst send (thousands / run)" style="html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1017.0" y="545" as="sourcePoint"/><mxPoint x="1151.0" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="11. user taps link (same as A)" style="html=1;endArrow=block;endFill=1;strokeColor=#cf222e;strokeWidth=1.5;fontColor=#cf222e;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1151.0" y="580" as="sourcePoint"/><mxPoint x="79.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Why rejected&lt;/b&gt;&lt;br&gt;&lt;b&gt;Latency:&lt;/b&gt; nudge lands 60-90 min after abandonment instead of at 60 min (lake landing lag + schedule).&lt;br&gt;&lt;b&gt;Correctness/cost:&lt;/b&gt; suppression is only as fresh as the lake. Carts bought in the last 5-30 min still get a nudge. At ~25k sends/day and ~$0.04/marketing message, each 1% of false sends ≈ $10/day plus complaints that lower the WhatsApp quality rating.&lt;br&gt;&lt;b&gt;Operational DB load:&lt;/b&gt; zero (same CDC ingestion). &lt;b&gt;Load shape:&lt;/b&gt; bursty sends every 15 min hit BSP rate tiers.&lt;br&gt;&lt;b&gt;What B does better:&lt;/b&gt; no streaming job to run. &lt;b&gt;Revisit if&lt;/b&gt; Flink is ever removed from the platform, or the nudge delay grows to 24 h (then nightly batch is enough)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#cf222e;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="655" width="1600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>