ck;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="749.0" y="515" as="sourcePoint"/><mxPoint x="1017.0" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="10. opt-in? cap? quiet hrs? FBT(SKUs)  [15 ms]" style="html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1017.0" y="545" as="sourcePoint"/><mxPoint x="1285.0" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="11. GET /carts/{id}: still open, in stock?  [40 ms]" style="html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1017.0" y="585" as="sourcePoint"/><mxPoint x="347.0" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="12. PK read (≤ 2/s)" style="html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.0" y="615" as="sourcePoint"/><mxPoint x="481.0" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="13. approved AR/EN template&lt;br&gt;+ signed deep link  [10 ms]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#bc4c00;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="951.0" y="632" width="132" height="36" as="geometry"/></mxCell><mxCell id="c48" value="14. send template  [600 ms]" style="html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1017.0" y="690" as="sourcePoint"/><mxPoint x="1151.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="15. status webhooks: delivered / read / STOP (missing: webhook receiver)" style="html=1;endArrow=block;endFill=1;strokeColor=#bc4c00;strokeWidth=1.5;fontColor=#bc4c00;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1151.0" y="730" as="sourcePoint"/><mxPoint x="749.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;opacity=35;" vertex="1" parent="1"><mxGeometry x="10" y="785" width="1612" height="235" as="geometry"/></mxCell><mxCell id="c51" value="Real-time request path (user waiting). P95 &lt;= 300 ms server side" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f6feb;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="787" width="900" height="20" as="geometry"/></mxCell><mxCell id="c52" value="16. user taps deep link -&gt; app opens" style="html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1151.0" y="825" as="sourcePoint"/><mxPoint x="79.0" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="17. GET /cart/restore?t=..  [10 ms]" style="html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="79.0" y="860" as="sourcePoint"/><mxPoint x="213.0" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="18. verify token  [5]" style="html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.0" y="890" as="sourcePoint"/><mxPoint x="347.0" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="19. load cart (PK)  [15]" style="html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.0" y="920" as="sourcePoint"/><mxPoint x="481.0" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="20. cart + FBT strip (SKUs in token)  [40]  = ~70 ms" style="html=1;endArrow=block;endFill=1;strokeColor=#1f6feb;strokeWidth=1.5;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.0" y="955" as="sourcePoint"/><mxPoint x="79.0" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="21. order.created via CDC -&gt; attribute conversion to nudge" style="html=1;endArrow=block;endFill=1;strokeColor=#1a7f37;strokeWidth=1.5;fontColor=#1a7f37;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="749.0" y="995" as="sourcePoint"/><mxPoint x="883.0" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="&lt;b&gt;Why A:&lt;/b&gt; sends exactly at T+60 min and re-checks the cart just before sending, so customers who already bought are not nudged (wasted spend, complaints, WhatsApp quality rating). Request path is key lookups only. Zero analytical load on the operational DB (CDC); the only extra DB work is one PK read per nudge (≤ 2/s) through the owning service. Flink is already deployed for session features; cart state ≈ 120k open carts × 1 KB ≈ 120 MB. &lt;b&gt;Fallback:&lt;/b&gt; CDP/FBT down -&gt; send the cart-only template; WhatsApp down -&gt; retry within 2 h, then drop." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#1a7f37;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="1600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="optionB" name="Option B (rejected) - Airflow micro-batch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Abandoned-cart nudge on WhatsApp: Option B (rejected). Airflow every 15 min over the lake" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#24292f;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Channel&lt;br&gt;(App / Web)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c4" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="79.0" y="116" as="sourcePoint"/><mxPoint x="79.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="154" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.0" y="116" as="sourcePoint"/><mxPoint x="213.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="E-commerce&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="288" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.0" y="116" as="sourcePoint"/><mxPoint x="347.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="Operational&lt;br&gt;DB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="422" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="481.0" y="116" as="sourcePoint"/><mxPoint x="481.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="CDC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="556" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615.0" y="116" as="sourcePoint"/><mxPoint x="615.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="Kafka" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="749.0" y="116" as="sourcePoint"/><mxPoint x="749.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="Flink" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f6f8fa;strokeColor=#57606a;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="824" y="60" width="118" height="56" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;endArrow=none;strokeColor=#57606a;strokeWidth=1;fontColor=#57606a;fontSize=10;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="883.0" y="116" as="sourcePoint"/><mxPoint x="883.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="Recommendation&lt;br&gt;Engine" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ddf4ff;strokeColor=#1f6feb;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="958" y="60"